{
  "name": "loyalty-integration-qa",
  "version": "0.1.0",
  "private": true,
  "description": "API and event-driven test suite for a mock loyalty platform",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start:loyalty": "tsx services/loyalty-engine/src/main.ts",
    "start:cdp": "tsx services/customer-data-platform/src/main.ts",
    "start:notifications": "tsx services/notification-service/src/main.ts",
    "start:broker": "tsx services/broker/src/main.ts",
    "test": "playwright test",
    "test:contract": "playwright test --project=contract",
    "test:api": "playwright test --project=api",
    "test:events": "playwright test --project=events",
    "test:integrity": "playwright test --project=integrity",
    "test:notifications": "playwright test --project=notifications",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
